generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobType {
  MAINTENANCE
  REPAIR
  INSPECTION
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  QUOTE_READY
  QUOTED
  RESOLVED
}

enum QuoteItemStatus {
  DRAFT
  QUOTE_READY
  QUOTED
  APPROVED
  REJECTED
}

enum InspectionFieldType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  PHOTO
}

enum MaintenanceFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  CUSTOM
}

enum UserRole {
  ADMIN
  OFFICE
  TECHNICIAN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(TECHNICIAN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobsAssigned Job[] @relation("JobAssignedTo")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  contactName String?
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites Site[]
}

model Site {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assets Asset[]
  jobs   Job[]
}

model Asset {
  id           String    @id @default(cuid())
  siteId       String
  name         String
  assetType    String?
  manufacturer String?
  model        String?
  serialNumber String?
  installDate  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  site                 Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  maintenanceSchedules MaintenanceSchedule[]
  issues               Issue[]
  attachments          Attachment[]
  jobs                 Job[]
}

model MaintenanceSchedule {
  id              String               @id @default(cuid())
  assetId         String
  frequency       MaintenanceFrequency
  customIntervalDays Int?
  lastCompletedAt DateTime?
  nextDueAt       DateTime?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  jobs  Job[]
}

model Job {
  id                    String    @id @default(cuid())
  siteId                String
  assetId               String?
  maintenanceScheduleId String?
  assignedToId          String?
  type                  JobType   @default(MAINTENANCE)
  status                JobStatus @default(SCHEDULED)
  title                 String
  scheduledDate         DateTime?
  completedDate         DateTime?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  site                Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  asset               Asset?               @relation(fields: [assetId], references: [id])
  maintenanceSchedule MaintenanceSchedule? @relation(fields: [maintenanceScheduleId], references: [id])
  assignedTo          User?                @relation("JobAssignedTo", fields: [assignedToId], references: [id])
  checklistResults    ChecklistResult[]
  issues              Issue[]
  attachments         Attachment[]
  reports             Report[]
}

model InspectionForm {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields           InspectionFormField[]
  checklistResults ChecklistResult[]
}

model InspectionFormField {
  id       String              @id @default(cuid())
  formId   String
  label    String
  fieldType InspectionFieldType @default(TEXT)
  options  String?
  order    Int                 @default(0)

  form    InspectionForm    @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers ChecklistAnswer[]
}

model ChecklistResult {
  id          String   @id @default(cuid())
  jobId       String
  formId      String
  submittedBy String?
  submittedAt DateTime @default(now())

  job     Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  form    InspectionForm    @relation(fields: [formId], references: [id])
  answers ChecklistAnswer[]
}

model ChecklistAnswer {
  id                String @id @default(cuid())
  checklistResultId String
  fieldId           String
  value             String?

  checklistResult ChecklistResult      @relation(fields: [checklistResultId], references: [id], onDelete: Cascade)
  field           InspectionFormField  @relation(fields: [fieldId], references: [id])
}

model Issue {
  id          String        @id @default(cuid())
  jobId       String
  assetId     String?
  description String
  severity    IssueSeverity @default(MEDIUM)
  status      IssueStatus   @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  asset       Asset?       @relation(fields: [assetId], references: [id])
  attachments Attachment[]
  quoteItems  QuoteItem[]
}

model Part {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?
  unit        String?
  unitPrice   Decimal  @db.Decimal(10, 2)
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quoteItems QuoteItem[]
}

model QuoteItem {
  id          String          @id @default(cuid())
  issueId     String?
  partId      String?
  description String
  quantity    Decimal         @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal         @db.Decimal(10, 2)
  status      QuoteItemStatus @default(QUOTE_READY)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  issue Issue? @relation(fields: [issueId], references: [id])
  part  Part?  @relation(fields: [partId], references: [id])
}

model Report {
  id          String   @id @default(cuid())
  jobId       String
  filePath    String
  fileName    String
  generatedAt DateTime @default(now())
  generatedBy String?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Attachment {
  id         String   @id @default(cuid())
  filePath   String
  fileName   String
  mimeType   String?
  size       Int?
  jobId      String?
  assetId    String?
  issueId    String?
  uploadedAt DateTime @default(now())

  job   Job?   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)
  issue Issue? @relation(fields: [issueId], references: [id], onDelete: Cascade)
}
